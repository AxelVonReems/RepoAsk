{
  "name": "ai-automation-worker",
  "version": "1.0.0",
  "type": "module",
  "description": "AI Automation Worker",
  "main": "index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "sync": "tsx src/sync/index.ts",
    "tool": "tsx src/tool/index.ts",
    "test": "DB_PATH=./data/test.db tsx --test --test-concurrency=1 src/**/*.test.ts",
    "test:win": "cmd /C \"set DB_PATH=:memory:&& tsx --test src/**/tests/*.test.ts\"",
    "stats": "tsx src/stats.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AxelVonReems/ai-automation-worker.git"
  },
