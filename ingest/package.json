  "bugs": {
    "url": "https://github.com/AxelVonReems/ai-automation-worker/issues"
  },
  "homepage": "https://github.com/AxelVonReems/ai-automation-worker#readme",
  "dependencies": {
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "p-retry": "^8.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
